# The page itself needs no dependencies: Three.js comes from a CDN. These are
# the harness's dev dependencies, and package-lock.json is committed so `npm ci`
# reproduces them exactly.
node_modules/

# logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# editors
.vscode/
.idea/
*.swp

# bench: per-run artifacts (bench/ref/*.png are the tracked references)
bench/last-*.png
bench/metrics.json
!bench/logs/*.log
